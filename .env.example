# See config/README.md for source priority and deployment examples.
# Required secrets and connection strings.
# JWT secret must contain at least 32 bytes for HS256.
LARA_MYSQL__URL=mysql://user:password@127.0.0.1:3306/lara
LARA_MONGODB__URI=mongodb://127.0.0.1:27017
LARA_JWT__SECRET=replace-with-a-long-random-secret

# Optional path to an additional TOML overlay.
# LARA_CONFIG_FILE=/etc/lara/config.toml

# Optional overrides for values from config/default.toml.
# LARA_SERVER__BIND_ADDRESS=127.0.0.1:3000
# LARA_MONGODB__DATABASE=lara
# LARA_JWT__ISSUER=lara
# LARA_JWT__AUDIENCE=lara-api
# LARA_JWT__TTL_SECONDS=3600
