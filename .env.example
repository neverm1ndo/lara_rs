# See config/README.md for source priority and deployment examples.
# Required secrets and connection strings.
# JWT secret must contain at least 32 bytes for HS256.
LARA_MYSQL__URL=mysql://user:password@127.0.0.1:3306/lara
LARA_MONGODB__URI=mongodb://127.0.0.1:27017
LARA_JWT__SECRET=replace-with-a-long-random-secret

# Optional path to an additional TOML overlay.
# LARA_CONFIG_FILE=/etc/lara/config.toml

# Optional overrides for values from config/default.toml.
# LARA_SERVER__BIND_ADDRESS=127.0.0.1:3000
# LARA_MONGODB__DATABASE=lara
# LARA_JWT__ISSUER=lara
# LARA_JWT__AUDIENCE=lara-api
# LARA_JWT__TTL_SECONDS=3600

# Game-server file storage. Prefer an absolute path in production.
# LARA_GAME_SERVER__STORAGE__ROOT=D:/servers/openmp
# LARA_GAME_SERVER__STORAGE__MAX_TREE_DEPTH=32
# LARA_GAME_SERVER__STORAGE__MAX_TREE_ENTRIES=10000
# LARA_GAME_SERVER__STORAGE__MAX_STREAM_SIZE_BYTES=10485760

# Configuration-file context. Paths must be relative to the storage root.
# Comma-separated values are parsed as lists. Every file not matched by a
# binary extension/name is treated as potentially textual; symlinks and
# junctions are always ignored independently of these settings.
# LARA_CONFIGURATION__FILES__CONFIGURATOR_DIRECTORY=scriptfiles/config
# LARA_CONFIGURATION__FILES__BINARY_EXTENSIONS=amx,dff,dll,exe,so,txd
# LARA_CONFIGURATION__FILES__BINARY_FILE_NAMES=omp-server,samp03svr
# LARA_CONFIGURATION__FILES__IGNORED_PATHS=logs,scriptfiles/cache
# LARA_CONFIGURATION__FILES__FALLBACK_ENCODING=windows-1251

# Maps context. The directory is relative to the game-server storage root.
# LARA_MAPS__FILES__DIRECTORY=scriptfiles/maps
# LARA_MAPS__UPLOAD__MAX_FILES_PER_REQUEST=50
# LARA_MAPS__UPLOAD__MAX_FILE_SIZE_BYTES=10485760
# LARA_MAPS__UPLOAD__MAX_TOTAL_SIZE_BYTES=52428800
