# Secrets are read by lara-rs.service and must be replaced before validation.
LARA_CONFIG_FILE="/etc/lara/production.toml"
LARA_MYSQL__URL=mysql://user:password@127.0.0.1:3306/lara
LARA_MONGODB__URI=mongodb://127.0.0.1:27017
LARA_JWT__SECRET=replace-with-a-long-random-secret
LARA_MFA__ENCRYPTION_KEY=replace-with-64-random-hex-characters
