# This file is an overlay for the safe defaults embedded into lara-rs.
# Install it as /etc/lara/production.toml and point LARA_CONFIG_FILE to it
# from /etc/lara/lara.env.

[game_server]
primary_instance = "main"

[[game_server.instances]]
id = "main"
display_name = "Main server"
kind = "primary"
environment = "production"
sort_order = 10
# Keep primary external until its separately coordinated systemd migration.
management = "external"
capabilities = [
    "overview",
    "lifecycle",
    "configuration",
    "maps",
    "backups",
    "incidents",
]
readiness = "uds"
incident_tracking = true

[[game_server.instances]]
id = "dev-dm"
display_name = "Developer DM"
kind = "auxiliary"
environment = "development"
sort_order = 20
# Systemd mode automatically enables D-Bus observation for this auxiliary.
management = "systemd"
systemd_unit = "lara-game@dev-dm.service"
storage_root = "/srv/openmp/dev-dm"
capabilities = ["overview", "lifecycle", "configuration", "incidents"]
readiness = "process"
incident_tracking = true

# Explicit policy is required for a configuration-capable auxiliary. Omitted
# values inherit the validated global configuration.files and storage limits.
# No binary artifact is writable until its exact relative path is listed.
# `lara instance add/edit --configuration-artifact-path gamemodes/test.amx`
# writes this allowlist after validating the complete startup configuration.
[game_server.instances.configuration]
fallback_encoding = "windows-1251"
ignored_paths = ["logs", "scriptfiles/cache"]
artifact_paths = []
max_file_size_bytes = 10485760

[game_server.storage]
root = "/srv/openmp/main"

[backups.storage]
directory = "/var/lib/lara/backups"
