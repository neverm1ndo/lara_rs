[Unit]
Description=Lara managed game server instance %i
Documentation=https://github.com/neverm1ndo/lara_rs
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=lara-game
Group=lara-game
WorkingDirectory=/srv/openmp/%i
EnvironmentFile=-/etc/lara/game-instances/%i.env
ExecStart=/srv/openmp/%i/omp-server

# The game server must stay in the foreground. Systemd owns its complete
# process tree and is the only component responsible for automatic restarts.
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30s
SendSIGKILL=yes
Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lara-game-%i
# Lara is a supplementary member of lara-game and needs group write access for
# instances that expose the configuration capability.
UMask=0007
LimitNOFILE=65536

# Baseline hardening. The instance can write only to its own server root.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/openmp/%i
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
