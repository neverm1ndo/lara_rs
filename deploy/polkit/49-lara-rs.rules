// Permit only Lara's dedicated service account to manage only validated
// lara-game@<instance>.service units and only the three lifecycle verbs used
// by the control plane. Package and game-server administration remain root-only.
polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var instanceUnit = /^lara-game@[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\.service$/;

    if (subject.user === "lara" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        instanceUnit.test(unit || "") &&
        ["start", "stop", "restart"].indexOf(verb) !== -1) {
        return polkit.Result.YES;
    }
});
